{
    "name": "swew/cli",
    "description": "SWEW/CLI: A PHP package for streamlined command line interface (CLI) development, providing an intuitive API for creating custom commands, handling input/output, and executing command logic effortlessly. Simplify your CLI application development with rapid development.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cli",
        "command-line",
        "console",
        "formatting",
        "input",
        "output",
        "program",
        "prompt",
        "terminal",
        "utility"
    ],
    "authors": [
        {
            "name": "AVIL13",
            "email": "avil@swew.app"
        }
    ],
    "archive": {
        "exclude": [
            "tests/*"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "Swew\\Cli\\": "src/"
        },
        "files": [
            "src/Functions/Functions.php"
        ],
        "exclude-from-classmap": [
            "spec",
            "/Tests/",
            "/test/",
            "/tests/"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "carthage-software/mago": "1.59.0",
        "swew/dd": "^1.4.2",
        "swew/test.phar": "^1.7.1"
    },
    "scripts": {
        "test": "t",
        "static": "mago analyze --minimum-report-level=warning --reporting-format=short",
        "lint": "mago lint --minimum-report-level=warning --minimum-fail-level=warning --reporting-format=short",
        "code-check": "mago format --check",
        "format": "mago format",
        "check": [
            "@static",
            "@lint",
            "@code-check",
            "@test"
        ]
    }
}
